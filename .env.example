# Resend API Key for backend email delivery (Required)
RESEND_API_KEY=

# Optional: recipient email where contact messages should be delivered
# Defaults to gssanjay128@gmail.com if not specified
CONTACT_TO_EMAIL=gssanjay128@gmail.com

# Optional: Sender address configured in Resend (default: onboarding@resend.dev)
# Once you verify your custom domain in Resend, update this to your verified sender (e.g. contact@yourdomain.com)
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
